#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["numpy"]
# ///
"""Watch a Parsec instance's screen for the Gamekeeper, and with --hunt follow targets.

It reports Gamekeeper sightings and saves marked-up snapshots. The instance
runs in its own X server (see parsec-nested), so the screen is read straight
from that server whether the window is visible or not.

With --hunt NAME, while that instance's macro runs, it steers the character
(see Follower), turning the camera with XTEST mouse motion, and walks it back
to where the macro was started by the coordinates under the minimap. Parsec passes mouse turns to the game only after it
has seen a click since its window last had focus, so a turn that never shows
gets a click first (one that leaves the left button as the macro had it).

Detection is plain colour thresholding. A mob's blue name is cyan (hue about
182-201, fairly saturated); in the game world nothing else is, so the pixels
of that colour are grouped into clusters and a cluster shaped like a line of
text is a hit. Other mobs have blue names too (Vicrodile, Gavial); the name
plate does not scale with distance, so the Gamekeeper is told apart by the
width of its name: 57-60 px at 1080p, the others 29-41. The chat box (item links are the same cyan) and the minimap
are left out. The guard's own blue ring around the character is a deeper blue
and the MP bar deeper still, so the hue range keeps them out.

  parsec-guard [--interval S] [--snapshots DIR] [--hunt NAME [--mode spot|level]] DISPLAY
  parsec-guard --image FILE.ppm                           test on a screenshot
  parsec-guard --calibrate NAME DISPLAY                   measure a full camera turn, then --home-test (macro off, open ground)
  parsec-guard --home-test NAME DISPLAY                   walk off 2 s and back by the coordinates (macro off)
  parsec-guard --teach NAME DISPLAY                       learn the mob under the crosshair (stand in reach of it)

Needs numpy (`pacman -S python-numpy`, or run it with `uv run --script`).
"""
import collections
import shutil
import base64
import ctypes
import ctypes.util
import json
import multiprocessing
import mmap
import math
import os
import signal
import subprocess
import sys
import threading
import time
import zlib

try:
    import numpy as np
except ImportError:
    sys.exit("parsec-guard needs numpy: sudo pacman -S python-numpy (or: uv run --script parsec-guard ...)")

# Hue 182-201 as integer tests on b >= g >= r: hue = 240 - 60 * (g - r) / (b - r).
HUE_LO, HUE_HI = 0.65, 0.967  # (g - r) / (b - r) for hue 201 and 182
SAT_MIN = 0.40
VAL_MIN = 97  # 38 % of 255

# The game draws 16:9; Parsec letterboxes it into whatever the window is.
GAME_ASPECT = 16 / 9
# UI areas as fractions of the game picture: (x0, y0, x1, y1).
EXCLUDE = (
    (0.0, 0.66, 0.31, 1.0),  # chat box: item links are the same cyan
    (0.92, 0.0, 1.0, 0.14),  # minimap
    (0.86, 0.17, 1.0, 0.27),  # quest tracker
)
CELL = 6  # px per clustering cell at 1080p
BACKGROUND_MAX = 110  # mean brightness around a name in the game world
