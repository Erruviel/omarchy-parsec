#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["numpy"]
# ///
"""Watch a Parsec instance's screen for the Gamekeeper, and with --hunt follow targets.

It reports Gamekeeper sightings and saves marked-up snapshots. The instance
runs in its own X server (see parsec-nested), so the screen is read straight
from that server whether the window is visible or not.

With --hunt NAME, while that instance's macro runs, it points the character
at targets for the macro to hit, turning the camera with XTEST mouse motion.
Mimics (yellow names) come to the character: it turns toward the nearest only
when none is in front, and never walks after them. To the Gamekeeper it runs
(W, stopping close), then walks the same way back with S, undoing the turns,
stopping each stretch by the coordinates under the minimap (minimap in the
top right corner). Parsec passes mouse turns to the game only after it has
seen a click since its window last had focus, so a turn that never shows
gets a click first (one that leaves the left button as the macro had it).
With --home as well, the older leash: walk back to where the macro started
once more than LEASH units away (unreliable, off by default).

Detection is plain colour thresholding. A mob's blue name is cyan (hue about
182-201, fairly saturated); in the game world nothing else is, so the pixels
of that colour are grouped into clusters and a cluster shaped like a line of
text is a hit. Other mobs have blue names too (Vicrodile, Gavial); the name
plate does not scale with distance, so the Gamekeeper is told apart by the
width of its name: 57-60 px at 1080p, the others 29-41. The chat box (item links are the same cyan) and the minimap
are left out. The guard's own blue ring around the character is a deeper blue
and the MP bar deeper still, so the hue range keeps them out.

  parsec-guard [--interval S] [--snapshots DIR] [--hunt NAME [--mode spot|level]] DISPLAY
  parsec-guard --image FILE.ppm                           test on a screenshot
  parsec-guard --calibrate NAME DISPLAY                   measure a full camera turn, then --home-test (macro off, open ground)
  parsec-guard --home-test NAME DISPLAY                   walk off 2 s and back by the coordinates (macro off)
  parsec-guard --teach NAME DISPLAY                       learn the mob under the crosshair (stand in reach of it)

Needs numpy (`pacman -S python-numpy`, or run it with `uv run --script`).
"""
import base64
import ctypes
import ctypes.util
import json
import math
import os
import signal
import subprocess
import sys
import time
import zlib

try:
    import numpy as np
except ImportError:
    sys.exit("parsec-guard needs numpy: sudo pacman -S python-numpy (or: uv run --script parsec-guard ...)")

# Hue 182-201 as integer tests on b >= g >= r: hue = 240 - 60 * (g - r) / (b - r).
HUE_LO, HUE_HI = 0.65, 0.967  # (g - r) / (b - r) for hue 201 and 182
SAT_MIN = 0.40
VAL_MIN = 97  # 38 % of 255

# The game draws 16:9; Parsec letterboxes it into whatever the window is.
GAME_ASPECT = 16 / 9
# UI areas as fractions of the game picture: (x0, y0, x1, y1).
EXCLUDE = (
    (0.0, 0.745, 0.31, 1.0),  # chat box: item links are the same cyan
    (0.92, 0.0, 1.0, 0.14),  # minimap
    (0.86, 0.17, 1.0, 0.27),  # quest tracker
)
CELL = 6  # px per clustering cell at 1080p
BACKGROUND_MAX = 110  # mean brightness around a name in the game world
NAME_WIDTH = (52, 66)  # "Gamekeeper", px at 1080p (measured 57-60)
MIMIC_WIDTH = (20, 28)  # "Mimic", px at 1080p (measured 23-25)

# Following, measured on vm1 and main (1512x910 windows).
KEY_W = 25  # X keycode of W: evdev 17, + 8
TURN_PX = 1.2  # image shift at 1080p per XTEST mouse unit to start from (vm1 1.2-1.4, main 0.4)
TURN_TIMEOUT = 1.5  # s for a turn to show in the stream (measured 0.25-0.9), else it was lost
AIM_OK = 40  # px at 1080p: a name this close to the crosshair is straight ahead
WALK_AIM = 120  # px at 1080p: walk only while the target is roughly ahead
NEAR = 120  # px at 1080p between the target's name and the character's: close enough to hit
WALK_MAX = 6.0  # s of walking at one go, then stop and look again
CHAR_DY = -30  # px at 1080p: the character's own name plate, relative to the crosshair
KEY_S = 39  # X keycode of S (evdev 31): walks backwards, facing the same way
HIT_DX, HIT_DIST = 90, 180  # px at 1080p: a Mimic this far at most is in front, being hit
CLOSE_EXTRA = 140  # px at 1080p beyond a target's reach distance: close, its name sways
# Mobs the user taught (parsec-guard --teach): colour, width and text shape of
# the name plate, and how far its name sits from the character's when it is
# in reach. Shared by all instances.
MOBS_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "parsec-multi", "mobs.json")
MOB_HUE_TOL = 8  # degrees of hue either side of the taught name's (14 lets yellow-green grass in)
MOB_WIDTH_TOL = 0.14  # of the taught width
MOB_SHAPE_MIN = 0.55  # correlation of the text shape with the taught one
VIVID = 0.75  # saturation of a deep-coloured name (dark red): may be darker than its ground
TEACH_LIT = 120  # lit pixels of a name reach at least this when taught (dark red ones about 140)
# The "Revive" button of the death window, grey levels at half size
# (taken at the larger HUD scale, 15x56); found at other scales by resizing.
REVIVE_TPL = np.frombuffer(base64.b64decode(""), np.uint8).reshape(15, 56).astype(np.float32)
REVIVE_MIN = 0.7  # correlation that makes a patch the button (none elsewhere reached 0.6)
REVIVE_HP = 0.9  # HP to heal to in the camp before walking back to the spot
REVIVE_HOLD_MAX = 90.0  # s to wait for that at most
REVIVE_OK = 4.0  # units from the spot that count as back after reviving
REVIVE_WALK_MAX = 180.0  # s of walking from the camp back to the spot before giving up
FAR_D = 300  # px at 1080p from the character: beyond this a name is far, and moves about twice as much per turn unit
FAR_GAIN = 2.0  # px per unit for far names until measured (vm1 measured 2.2 on the Gamekeeper)
MOB_REACH = 75  # px at 1080p between a taught mob's name and the character's: in reach of a blow (hits seen at 46-66)
PITCH_DOWN, PITCH_BACK = 1000, 450  # mouse units: to the camera's stop looking down, then back (main: horizon just out of view)
PITCH_EVERY = 90.0  # s: at most this often, when it starts looking round
REF_Y = 30  # px at 1080p below the crosshair: the character's middle, to tell where a close mob stands (names over it: ahead, under it: behind)
FRONT = math.radians(25)  # a close mob within this angle of the way the character faces is in front of it
UNITS_RAD = 525  # mouse units per radian of camera turn when not calibrated (main measured 525-593)
TEXT_CONTRAST = 40  # a name's pixels are this much brighter (max channel) than what is around them
TEXT_POP = 30  # a pixel of a taught name is this much brighter than the mean of the 15 px around it
KEEPER_RANGE = 15.0  # metres from where a chase starts the character may run; set per instance in the panel
KEEPER_GONE = 2.5  # s without the Gamekeeper's name: dead (or gone), walk back
CHASE_MAX = 300.0  # s after the Gamekeeper before walking back anyway
MIMIC_REACT = 0.8  # s with no Mimic in front before turning to one, like a player noticing
TURN_REST = 1.5  # s at least between two turns toward Mimics
MIMIC_RESPAWN = 10.0  # s Mimics take to come back once all are dead: keep still meanwhile
SCAN_STEPS = 4  # looks around (a quarter turn each: one full turn) after that wait, before waiting again
FIGHT_SHOTS = 40  # pictures of fights kept per run, to learn the damage numbers from
# Home: the position the macro was started at, read from the coordinates
# under the minimap (minimap in the top right corner).
COORD_BOX = (0.86, 0.08, 1.0, 0.26)  # game-picture fractions searched for the "x, y" line
LEASH = 5.0  # game units (metres) from home: Mimics walk back beyond 4-5
HOME_OK = 1.5  # units from home that count as back
RETURN_MAX = 45.0  # s of walking home before giving up
UPR_RANGE = (4000, 40000)  # mouse units per radian, sane bounds (vm1 measured about 16000)
# Digit templates 0-9, 6x10 cells of the minimap coordinates' font, built from
# hand-read frames of a -hidpi instance (1063 px high game picture).
