#!/usr/bin/env python3
"""The smallest window manager a rootful Xwayland needs for Parsec.

A rootful Xwayland has no window manager. Two things go wrong without one:

- Parsec's window keeps whatever size it chose at start, while the X screen
  follows the size of the Xwayland window on the Hyprland side. Every
  top-level window of the given class is fitted to the screen, once or (with
  --watch) whenever either changes.
- Parsec only fills its Computers list (and takes clicks) once a window
  manager has announced its window as the active one: it reads
  `_NET_ACTIVE_WINDOW` and the X input focus. So this also plays the EWMH
  part of a window manager: `_NET_SUPPORTING_WM_CHECK` on the root, the
  Parsec window as `_NET_ACTIVE_WINDOW` and `_NET_CLIENT_LIST`, and the
  input focus kept on it.
- Mouse deltas. A rootful Xwayland hands XI2 raw motion to clients from the
  accelerated, rounded pointer movement unless the cursor is hidden the
  XFixes way; slow movements then round to zero and a game feels sluggish,
  with fast flicks getting through. Parsec hides its cursor with an empty
  1x1 pixmap instead, which is not enough for Xwayland. So whenever Parsec's
  cursor is that empty one, it is hidden here with XFixesHideCursor as well,
  and shown again when Parsec brings a cursor back. Hiding alone is not
  enough: Xwayland only switches to its pointer-lock path (relative motion
  straight from the compositor, same as the regular rootless server) when a
  client also warps the pointer. So the pointer is warped once, to where it
  already is: the aim stays put (a warp to the centre, tried once, made the
  farming macro click the wrong spot).
"""
import ctypes
import ctypes.util
import sys
import time

X = ctypes.CDLL(ctypes.util.find_library("X11"))
X.XOpenDisplay.restype = ctypes.c_void_p
X.XOpenDisplay.argtypes = [ctypes.c_char_p]
X.XDefaultRootWindow.restype = ctypes.c_ulong
X.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
X.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
X.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
X.XQueryTree.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong)), ctypes.POINTER(ctypes.c_uint),
]
X.XFree.argtypes = [ctypes.c_void_p]
X.XMoveResizeWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint]
X.XFlush.argtypes = [ctypes.c_void_p]
X.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
X.XSetErrorHandler.argtypes = [ctypes.c_void_p]


class XClassHint(ctypes.Structure):
    _fields_ = [("res_name", ctypes.c_char_p), ("res_class", ctypes.c_char_p)]


X.XGetClassHint.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(XClassHint)]


class XWA(ctypes.Structure):
    _fields_ = [
        ("x", ctypes.c_int), ("y", ctypes.c_int), ("width", ctypes.c_int), ("height", ctypes.c_int),
        ("border", ctypes.c_int), ("depth", ctypes.c_int), ("visual", ctypes.c_void_p), ("root", ctypes.c_ulong),
        ("cls", ctypes.c_int), ("bit_gravity", ctypes.c_int), ("win_gravity", ctypes.c_int),
        ("backing_store", ctypes.c_int), ("backing_planes", ctypes.c_ulong), ("backing_pixel", ctypes.c_ulong),
        ("save_under", ctypes.c_int), ("colormap", ctypes.c_ulong), ("map_installed", ctypes.c_int),
        ("map_state", ctypes.c_int), ("all_event_masks", ctypes.c_long), ("your_event_mask", ctypes.c_long),
        ("do_not_propagate_mask", ctypes.c_long), ("override_redirect", ctypes.c_int), ("screen", ctypes.c_void_p),
    ]


X.XGetWindowAttributes.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(XWA)]
X.XGetGeometry.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint),
]


X.XSetErrorHandler.argtypes = [ctypes.c_void_p]
# Windows come and go between a query and the request that uses them; a
# BadWindow then must not kill the watcher (Xlib's default handler exits).
ERROR_HANDLER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)(lambda d, e: 0)
X.XSetErrorHandler(ERROR_HANDLER)


def screen_size(dpy, root: int) -> tuple[int, int]:
    """The root window's current size. XDisplayWidth/Height are cached at
    connect time and never notice the Hyprland window being resized; a
    geometry round trip does."""
    r = ctypes.c_ulong()
    x = ctypes.c_int()
    y = ctypes.c_int()
    w = ctypes.c_uint()
    h = ctypes.c_uint()
    bw = ctypes.c_uint()
    depth = ctypes.c_uint()
    X.XGetGeometry(dpy, root, ctypes.byref(r), ctypes.byref(x), ctypes.byref(y), ctypes.byref(w), ctypes.byref(h), ctypes.byref(bw), ctypes.byref(depth))
    return w.value, h.value
X.XInternAtom.restype = ctypes.c_ulong
X.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
X.XChangeProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_int,
]
X.XCreateSimpleWindow.restype = ctypes.c_ulong
X.XCreateSimpleWindow.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint, ctypes.c_ulong, ctypes.c_ulong,
]
X.XSetInputFocus.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
X.XGetInputFocus.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int)]
XA_ATOM, XA_CARDINAL, XA_WINDOW = 4, 6, 33
REVERT_TO_PARENT = 2

XF = ctypes.CDLL(ctypes.util.find_library("Xfixes"))


class XFixesCursorImage(ctypes.Structure):
    _fields_ = [
        ("x", ctypes.c_short), ("y", ctypes.c_short), ("width", ctypes.c_ushort), ("height", ctypes.c_ushort),
        ("xhot", ctypes.c_ushort), ("yhot", ctypes.c_ushort), ("cursor_serial", ctypes.c_ulong),
        ("pixels", ctypes.POINTER(ctypes.c_ulong)), ("atom", ctypes.c_ulong), ("name", ctypes.c_char_p),
    ]


XF.XFixesGetCursorImage.restype = ctypes.POINTER(XFixesCursorImage)
XF.XFixesGetCursorImage.argtypes = [ctypes.c_void_p]
XF.XFixesHideCursor.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
XF.XFixesShowCursor.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
X.XWarpPointer.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint, ctypes.c_int, ctypes.c_int,
]
X.XQueryPointer.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_uint),
]


def warp_in_place(dpy) -> None:
    """XWarpPointer to the pointer's own position: no movement, but it is
    what makes Xwayland lock the (hidden) pointer and pass relative motion."""
    root = X.XDefaultRootWindow(dpy)
    r = ctypes.c_ulong()
    child = ctypes.c_ulong()
    rx = ctypes.c_int()
    ry = ctypes.c_int()
    wx = ctypes.c_int()
    wy = ctypes.c_int()
    mask = ctypes.c_uint()
    if X.XQueryPointer(dpy, root, ctypes.byref(r), ctypes.byref(child), ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask)):
        X.XWarpPointer(dpy, 0, root, 0, 0, 0, 0, rx.value, ry.value)


def cursor_is_empty(dpy) -> bool | None:
    """True when the current cursor has no visible pixel (Parsec's way of
    hiding it), False for a real cursor, None when it cannot be read."""
    image = XF.XFixesGetCursorImage(dpy)
    if not image:
        return None
    try:
        c = image.contents
        n = c.width * c.height
        if n == 0:
            return True
        for i in range(n):
            if (c.pixels[i] >> 24) & 0xFF:
                return False
        return True
    finally:
        X.XFree(image)


class CursorShadow:
    """Mirror Parsec's empty cursor as a real XFixes hide on its window."""

    def __init__(self, dpy) -> None:
        self.dpy = dpy
        self.hidden_on = 0

    def update(self, win: int) -> None:
        empty = cursor_is_empty(self.dpy)
        if empty is None:
            return
        if empty and self.hidden_on != win:
            if self.hidden_on:
                XF.XFixesShowCursor(self.dpy, self.hidden_on)
            XF.XFixesHideCursor(self.dpy, win)
            self.hidden_on = win
            X.XSync(self.dpy, 0)
            warp_in_place(self.dpy)
            X.XSync(self.dpy, 0)
        elif not empty and self.hidden_on:
            XF.XFixesShowCursor(self.dpy, self.hidden_on)
            self.hidden_on = 0
            X.XSync(self.dpy, 0)

class FakeWM:
    """EWMH announcements, so clients believe a window manager is present."""

    def __init__(self, dpy) -> None:
        self.dpy = dpy
        self.root = X.XDefaultRootWindow(dpy)
        self.active = 0
        self.check = X.XCreateSimpleWindow(dpy, self.root, -1, -1, 1, 1, 0, 0, 0)
        self._prop(self.check, "_NET_SUPPORTING_WM_CHECK", XA_WINDOW, [self.check])
        self._utf8(self.check, "_NET_WM_NAME", "parsec-xfit")
        self._prop(self.root, "_NET_SUPPORTING_WM_CHECK", XA_WINDOW, [self.check])
        self._utf8(self.root, "_NET_WM_NAME", "parsec-xfit")
        supported = (
            "_NET_SUPPORTING_WM_CHECK", "_NET_ACTIVE_WINDOW", "_NET_CLIENT_LIST", "_NET_WM_STATE",
            "_NET_WM_STATE_FULLSCREEN", "_NET_WM_PID", "_NET_WM_PING", "_NET_WM_WINDOW_TYPE",
            "_NET_NUMBER_OF_DESKTOPS", "_NET_CURRENT_DESKTOP",
        )
        self._prop(self.root, "_NET_SUPPORTED", XA_ATOM, [self._atom(a) for a in supported])
        self._prop(self.root, "_NET_NUMBER_OF_DESKTOPS", XA_CARDINAL, [1])
        self._prop(self.root, "_NET_CURRENT_DESKTOP", XA_CARDINAL, [0])

    def _atom(self, name: str) -> int:
        return X.XInternAtom(self.dpy, name.encode(), 0)

    def _prop(self, win: int, name: str, typ: int, values: list) -> None:
        arr = (ctypes.c_ulong * len(values))(*values)
        X.XChangeProperty(self.dpy, win, self._atom(name), typ, 32, 0, arr, len(values))

    def _utf8(self, win: int, name: str, text: str) -> None:
        raw = text.encode()
        X.XChangeProperty(self.dpy, win, self._atom(name), self._atom("UTF8_STRING"), 8, 0, raw, len(raw))

    def activate(self, win: int) -> None:
        if win != self.active:
            self._prop(self.root, "_NET_ACTIVE_WINDOW", XA_WINDOW, [win])
            self._prop(self.root, "_NET_CLIENT_LIST", XA_WINDOW, [win])
            self.active = win
        focused = ctypes.c_ulong()
        revert = ctypes.c_int()
        X.XGetInputFocus(self.dpy, ctypes.byref(focused), ctypes.byref(revert))
        if focused.value != win:
            X.XSetInputFocus(self.dpy, win, REVERT_TO_PARENT, 0)


def fit_once(dpy, wanted: bytes, wm: FakeWM | None = None, shadow: CursorShadow | None = None) -> int:
    root = X.XDefaultRootWindow(dpy)
    width, height = screen_size(dpy, root)
    r = ctypes.c_ulong()
    p = ctypes.c_ulong()
    kids = ctypes.POINTER(ctypes.c_ulong)()
    n = ctypes.c_uint()
    if not X.XQueryTree(dpy, root, ctypes.byref(r), ctypes.byref(p), ctypes.byref(kids), ctypes.byref(n)):
        return 0
    fitted = 0
    for i in range(n.value):
        hint = XClassHint()
        if not X.XGetClassHint(dpy, kids[i], ctypes.byref(hint)) or hint.res_class != wanted:
            continue
        attrs = XWA()
        if not X.XGetWindowAttributes(dpy, kids[i], ctypes.byref(attrs)) or attrs.map_state != 2:
            continue
        if (attrs.x, attrs.y, attrs.width, attrs.height) != (0, 0, width, height):
            X.XMoveResizeWindow(dpy, kids[i], 0, 0, width, height)
            fitted += 1
        if wm is not None:
            wm.activate(kids[i])
        if shadow is not None:
            shadow.update(kids[i])
    if n.value:
        X.XFree(kids)
    X.XSync(dpy, 0)
    return fitted


def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    watch = "--watch" in sys.argv
    if len(args) != 2:
        print("usage: parsec-xfit [--watch] DISPLAY WM_CLASS", file=sys.stderr)
        return 2
    display, wm_class = args
    dpy = X.XOpenDisplay(display.encode())
    if not dpy:
        print(f"cannot open {display}", file=sys.stderr)
        return 1
    wm = FakeWM(dpy)
    shadow = CursorShadow(dpy)
    if not watch:
        fit_once(dpy, wm_class.encode(), wm, shadow)
        return 0
    # Polling is cheaper than the RandR/structure/cursor event dance: the
    # cursor state wants a quick answer (the first slow mouse movements after
    # a game hides it), a resize can wait a second.
    tick = 0
    while True:
        try:
            if tick % 10 == 0:
                fit_once(dpy, wm_class.encode(), wm, shadow)
            elif wm.active:
                shadow.update(wm.active)
        except Exception:  # noqa: BLE001 - the server went away; the wrapper ends us
            return 0
        tick += 1
        time.sleep(0.1)


if __name__ == "__main__":
    sys.exit(main())
